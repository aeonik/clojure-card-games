# Local deploy environment for contributors.
#
# Copy the lines you need into your shell profile or source a private local
# file before running bin/karbosh-deploy. Do not put secrets in this file.

export KARBOSH_DEPLOY_HOST=dc3systems.com

# dc3systems.com accepts direct SSH deploy traffic on this port.
export KARBOSH_SSH_PORT=22122

# Optional equivalent to KARBOSH_SSH_PORT when rsync needs a full transport.
# export KARBOSH_RSYNC_RSH="ssh -p 22122"

export KARBOSH_APP_DIR=/home/dave/apps/clojure-card-games/
export KARBOSH_STATIC_DIR=/var/www/dc3systems.com/public_html/karbosh/
export KARBOSH_HEALTH_URL=https://dc3systems.com/karbosh/api/health
export KARBOSH_RESTART_COMMAND="sudo systemctl restart karbosh.service"
